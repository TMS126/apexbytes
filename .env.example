# Public site URL used by metadata and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only Cloudinary credentials. Set these in the hosting provider's
# encrypted environment-variable settings; never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis REST credentials. The upload route fails closed without them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile. The public site key is exposed to the browser; keep the
# secret key server-only and set the expected production hostname exactly.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=your-domain.example

# Server-only administration and scheduled-cleanup controls. Generate long,
# unique values; do not send either value to a browser or commit it to source.
ADMIN_UPLOADS_SECRET=
CRON_SECRET=
UPLOAD_RETENTION_DAYS=30

# Keep uploads disabled until Cloudinary authenticated delivery, durable
# retention, Redis rate limiting, and Turnstile verification are configured.
UPLOADS_ENABLED=false
